# Noms seulement. Les valeurs sont réglées sur le serveur (/opt/usine-axion-ia), jamais dans le dépôt.
DATABASE_URL=
SESSION_SECRET=
# Facultative : sans elle, Will choisit son mot de passe à la première ouverture (gardé haché en base).
USINE_PASSWORD_HASH_B64=
# « oui » seulement le temps de la première ouverture ; sans effet dès qu'un mot de passe existe.
USINE_PREMIERE_OUVERTURE=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Porte du studio : secret partagé avec le studio (32 caractères au moins). Vide : la porte est éteinte (404).
USINE_PORTE_SECRET=
# Chiffres agrégés du CRM (L3d) : secret HMAC partagé avec le CRM, 32 caractères au moins. Vide ou plus court : la route /api/agregats-crm est éteinte (404). Elle l'est aussi tant que l'interrupteur « agregats.recepteur » est éteint (réglages).
USINE_AGREGATS_CRM_SECRET=
# Adresses IP de sortie du CRM, séparées par des virgules. OBLIGATOIRE : vide = tout est refusé (403), même signé.
USINE_AGREGATS_CRM_IPS=
# Garde externe des bases (CI seulement) : jeton de lecture seule de la source des bases, dépôt source « propriétaire/nom » et chemin du manifeste dans ce dépôt.
PLANS_PRIVE_LECTURE=
PLANS_PRIVE_DEPOT=
PLANS_PRIVE_MANIFESTE=
# Passerelle sortante vers le Studio (L7-23) : secret SORTANT, distinct de USINE_PORTE_SECRET, 32 caractères au moins. Vide : aucun appel au Studio (éteinte). Elle l'est aussi tant que l'interrupteur « studio.sortant » est éteint.
STUDIO_PORTE_SECRET=
# Horloge hebdomadaire (U-HORLOGE) : secret de la tâche du serveur qui déclenche la proposition de la semaine, distinct de la porte, 32 caractères au moins. Vide : toute demande est refusée (401). Rien ne part non plus tant que l'interrupteur « horloge.semaine » est éteint.
USINE_HORLOGE_SECRET=
# Réservations du site (UO-07) : jeton de lecture seule du site, lu côté serveur. Vide : aucune lecture. Rien n'est lu non plus tant que l'interrupteur « reservations » est éteint.
RESERVATIONS_JETON=
# Alerte de silence (veille) : chemin du fichier local où est déposé l'état d'alerte lu par le cockpit. Vide : rien n'est écrit.
VEILLE_ETAT_FICHIER=
# Second code par courriel (SCC-2) : l'Usine n'envoie rien tant que ces valeurs sont vides ET que l'essai de mise en service n'a pas réussi. Valeurs posées par le fondateur seul, sur le serveur.
# Fournisseur : « zeptomail » ou « brevo ». Vide ou autre : aucun envoi.
COURRIEL_FOURNISSEUR=
# Clé d'envoi du fournisseur. Vide : aucun envoi.
COURRIEL_CLE_API=
# Adresse d'expédition validée chez le fournisseur.
COURRIEL_EXPEDITEUR=
# Adresse qui reçoit le code : serveur seulement, jamais saisie, modifiable ni affichée dans l'Usine.
USINE_COURRIEL_SECOND_CODE=
