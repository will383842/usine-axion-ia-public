# Noms seulement. Les valeurs sont réglées sur le serveur (/opt/usine-axion-ia), jamais dans le dépôt.
DATABASE_URL=
SESSION_SECRET=
# Facultative : sans elle, Will choisit son mot de passe à la première ouverture (gardé haché en base).
USINE_PASSWORD_HASH_B64=
# « oui » seulement le temps de la première ouverture ; sans effet dès qu'un mot de passe existe.
USINE_PREMIERE_OUVERTURE=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Porte du studio : secret partagé avec le studio (32 caractères au moins). Vide : la porte est éteinte (404).
USINE_PORTE_SECRET=
# Chiffres agrégés du CRM (L3d) : secret HMAC partagé avec le CRM, 32 caractères au moins. Vide ou plus court : la route /api/agregats-crm est éteinte (404). Elle l'est aussi tant que l'interrupteur « agregats.recepteur » est éteint (réglages).
USINE_AGREGATS_CRM_SECRET=
# Adresses IP de sortie du CRM, séparées par des virgules. OBLIGATOIRE : vide = tout est refusé (403), même signé.
USINE_AGREGATS_CRM_IPS=
